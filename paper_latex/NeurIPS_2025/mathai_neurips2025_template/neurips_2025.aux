\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {LLM Judge monotonicity sanity checks (P2/P3).} VeriBench-wide GPT-5.3-Codex API run (\(n_\text  {files}=184\), \(n_\text  {repeats}=3\), with \(\pm 1\) SE bands for readability; these are not 95\% confidence intervals). \textbf  {P2 (bugs):} 920 ladder points show a negative trend (Pearson \(r=-0.687\), Spearman \(\rho =-0.808\)); full-ladder weak monotonicity is \(52.2\%\). \textbf  {P3 (missing specs):} 920 points show stronger monotonic behavior (Pearson \(r=-0.892\), Spearman \(\rho =-0.899\)); weak monotonicity is \(89.1\%\). Identity (P1) is reported separately in Table~\ref {tab:codex_identity_variants} and appendix diagnostics.}}{6}{figure.caption.17}\protected@file@percent }
\newlabel{fig:judge_sanity_checks}{{3}{6}{\textbf {LLM Judge monotonicity sanity checks (P2/P3).} VeriBench-wide GPT-5.3-Codex API run (\(n_\text {files}=184\), \(n_\text {repeats}=3\), with \(\pm 1\) SE bands for readability; these are not 95\% confidence intervals). \textbf {P2 (bugs):} 920 ladder points show a negative trend (Pearson \(r=-0.687\), Spearman \(\rho =-0.808\)); full-ladder weak monotonicity is \(52.2\%\). \textbf {P3 (missing specs):} 920 points show stronger monotonic behavior (Pearson \(r=-0.892\), Spearman \(\rho =-0.899\)); weak monotonicity is \(89.1\%\). Identity (P1) is reported separately in Table~\ref {tab:codex_identity_variants} and appendix diagnostics}{figure.caption.17}{}}
