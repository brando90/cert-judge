\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {LLM Judge Trustworthiness Sanity Checks.} VeriBench-wide GPT-5.3-Codex API run (\(n_\text  {files}=184\), \(n_\text  {repeats}=3\), with standard-error overlays). \textbf  {(a) Identity:} 736 syntactic-variant pairs yield mean score \(0.792\) (\(\sigma =0.352\)); \textsc  {Style}/\textsc  {Rename} remain high while aggressive \textsc  {Alpha}-renaming is harder. \textbf  {(b) Monotonicity vs.\ Bugs:} 920 ladder points show a negative trend (Pearson \(r=-0.687\), Spearman \(\rho =-0.808\)); full-ladder weak monotonicity is \(52.2\%\). \textbf  {(c) Monotonicity vs.\ Missing Specs:} 920 points show stronger monotonic behavior (Pearson \(r=-0.892\), Spearman \(\rho =-0.899\)); weak monotonicity is \(89.1\%\).}}{4}{figure.caption.12}\protected@file@percent }
\newlabel{fig:judge_sanity_checks}{{1}{4}{\textbf {LLM Judge Trustworthiness Sanity Checks.} VeriBench-wide GPT-5.3-Codex API run (\(n_\text {files}=184\), \(n_\text {repeats}=3\), with standard-error overlays). \textbf {(a) Identity:} 736 syntactic-variant pairs yield mean score \(0.792\) (\(\sigma =0.352\)); \textsc {Style}/\textsc {Rename} remain high while aggressive \textsc {Alpha}-renaming is harder. \textbf {(b) Monotonicity vs.\ Bugs:} 920 ladder points show a negative trend (Pearson \(r=-0.687\), Spearman \(\rho =-0.808\)); full-ladder weak monotonicity is \(52.2\%\). \textbf {(c) Monotonicity vs.\ Missing Specs:} 920 points show stronger monotonic behavior (Pearson \(r=-0.892\), Spearman \(\rho =-0.899\)); weak monotonicity is \(89.1\%\)}{figure.caption.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Identity breakdown for the Codex API run.} The low overall identity mean (\(0.792\)) is primarily driven by aggressive alpha-renaming.}}{4}{table.caption.13}\protected@file@percent }
\newlabel{tab:codex_identity_variants}{{1}{4}{\textbf {Identity breakdown for the Codex API run.} The low overall identity mean (\(0.792\)) is primarily driven by aggressive alpha-renaming}{table.caption.13}{}}
