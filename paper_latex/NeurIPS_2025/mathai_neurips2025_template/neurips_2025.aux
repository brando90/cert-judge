\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Scalable judge evaluation: cost efficiency with human alignment.} \textbf  {(A)} Illustrative scaling comparison: human evaluation cost grows with dataset size and number of judges/methods (\(O(N \cdot C_{\text  {human}} \cdot J)\)), while certified property evaluation scales with automated property checks (\(O(N \cdot C_{\text  {llm}} \cdot P)\), with small fixed \(P\)). This yields a practical weeks-to-hours reduction in evaluation runtime. \textbf  {(B)} Judge-level trend from Exp16: higher certification index corresponds to higher human correlation, showing that lower evaluation cost is achieved without sacrificing human alignment.}}{2}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:pull-cost-alignment}{{1}{2}{\textbf {Scalable judge evaluation: cost efficiency with human alignment.} \textbf {(A)} Illustrative scaling comparison: human evaluation cost grows with dataset size and number of judges/methods (\(O(N \cdot C_{\text {human}} \cdot J)\)), while certified property evaluation scales with automated property checks (\(O(N \cdot C_{\text {llm}} \cdot P)\), with small fixed \(P\)). This yields a practical weeks-to-hours reduction in evaluation runtime. \textbf {(B)} Judge-level trend from Exp16: higher certification index corresponds to higher human correlation, showing that lower evaluation cost is achieved without sacrificing human alignment}{figure.caption.2}{}}
