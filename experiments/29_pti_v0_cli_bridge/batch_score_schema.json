{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "scores": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "reasoning": {
            "type": "string"
          },
          "score": {
            "maximum": 1.0,
            "minimum": 0.0,
            "type": "number"
          }
        },
        "required": [
          "id",
          "score",
          "reasoning"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "scores"
  ],
  "type": "object"
}
